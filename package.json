{
  "name": "local-project-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "projectctl": "bin/projectctl.mjs"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file-if-exists=.env server.ts",
