DATABASE_URL=postgresql://localhost:55432/project_lab
PORT=4317
DATA_DIR=./data
APP_ENV=development
INSTANCE_ID=local-development

# 本地产品运行默认使用钉钉账号认证。development 仅用于隔离开发和自动测试。
AUTH_MODE=dingtalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=http://127.0.0.1:4317/api/auth/dingtalk/callback
DINGTALK_BOOTSTRAP_FIRST_ADMIN=true
AUTH_SESSION_DAYS=7
