{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "project-management",
  "target_platforms": ["codex", "sealseek"],
  "capabilities": [
    {
      "id": "project.service.directory.list",
      "purpose": "Read the complete folder and active-project directory from the selected service",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "read_only",
        "folder_project_relationships",
        "structured_json"
      ],
      "input_fields": ["profile"],
      "output_fields": ["target", "counts", "folders", "projects"],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "The authenticated user may read the shared company project directory."
      },
      "errors": ["AUTH_REQUIRED", "NOT_FOUND", "PROVIDER_FAILURE"]
    },
    {
      "id": "project.service.task.list",
      "purpose": "Resolve one project by exact name and read all of its task nodes",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "read_only",
        "exact_project_name_resolution",
        "complete_task_nodes",
        "structured_json"
      ],
      "input_fields": ["profile", "project"],
      "output_fields": ["target", "project", "count", "tasks"],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "The authenticated user may read tasks in a visible company project."
      },
      "errors": ["AUTH_REQUIRED", "NOT_FOUND", "PROVIDER_FAILURE"]
    },
    {
      "id": "project.service.task.read",
      "purpose": "Resolve one project and task node by exact name and read its full state and related records",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "read_only",
        "exact_project_name_resolution",
        "exact_task_name_resolution",
        "natural_language_project_resolution",
        "folder_as_project_context",
        "natural_language_task_resolution",
        "ambiguity_clarification",
        "status_history",
        "related_records",
        "structured_json"
      ],
      "input_fields": ["profile", "project", "task"],
      "output_fields": [
        "target",
        "project",
        "task",
        "dependencies",
        "dependents",
        "status_history",
        "records"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "The authenticated user may read task state and records in a visible company project."
      },
      "errors": [
        "AUTH_REQUIRED",
        "NOT_FOUND",
        "TASK_NAME_AMBIGUOUS",
        "PROVIDER_FAILURE"
      ]
    },
    {
      "id": "project.service.task.create",
      "purpose": "Create one task from a compact current project snapshot with server preview, project-scoped optimistic concurrency, and post-write verification",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "compact_prewrite_snapshot",
        "exact_project_resolution",
        "exact_node_resolution",
        "member_and_task_reference_resolution",
        "server_dry_run",
        "project_scoped_optimistic_concurrency",
        "idempotent_write",
        "production_confirmation",
        "post_write_readback",
        "structured_json"
      ],
      "input_fields": [
        "profile",
        "project",
        "node",
        "title",
        "description",
        "criteria",
        "owner",
        "reviewer",
        "priority",
        "due_date",
        "depends_on",
        "before_task",
        "after_task",
        "skill",
        "context_token",
        "idempotency_key"
      ],
      "output_fields": [
        "target",
        "project",
        "task",
        "project_version",
        "idempotency_key",
        "verification"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "The user must explicitly intend to add the task. A fresh project context and server preview are required; production additionally requires CLI confirmation."
      },
      "errors": [
        "AUTH_REQUIRED",
        "CONTEXT_TOKEN_REQUIRED",
        "PROJECT_STATE_CHANGED",
        "TASK_NAME_CONFLICT",
        "NODE_NOT_FOUND",
        "MEMBER_NOT_FOUND",
        "MEMBER_AMBIGUOUS",
        "INVALID_DEPENDENCY",
        "POSITION_TASK_INVALID",
        "CONFIRMATION_REQUIRED",
        "PROVIDER_FAILURE",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "project.service.task.delete",
      "purpose": "Preview and recoverably delete one task with exact confirmation, dependency handling, idempotency, and readback",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "compact_prewrite_snapshot",
        "impact_preview",
        "exact_name_confirmation",
        "project_scoped_optimistic_concurrency",
        "dependency_policy",
        "recoverable_archive",
        "idempotent_write",
        "production_confirmation",
        "post_write_readback",
        "structured_json"
      ],
      "input_fields": [
        "profile",
        "project",
        "task",
        "confirm_task",
        "dependency_policy",
        "rewire_to",
        "idempotency_key"
      ],
      "output_fields": [
        "target",
        "deletion_id",
        "project",
        "task",
        "manifest_path",
        "retention_until",
        "verification"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "The user must review the current impact preview and explicitly confirm the exact task name; production additionally requires CLI confirmation."
      },
      "errors": [
        "AUTH_REQUIRED",
        "DELETE_CONFIRMATION_MISMATCH",
        "DEPENDENTS_EXIST",
        "PROJECT_STATE_CHANGED",
        "DELETE_SCOPE_CHANGED",
        "ADMIN_REQUIRED",
        "FEATURE_UNSUPPORTED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "project.service.trash.list",
      "purpose": "Read recoverable task deletion batches and their manifests",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "read_only",
        "manifest_readback",
        "structured_json"
      ],
      "input_fields": ["profile", "project", "deletion_id"],
      "output_fields": ["target", "count", "items", "manifest"],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "The authenticated user may read visible project recycle records."
      },
      "errors": ["AUTH_REQUIRED", "NOT_FOUND", "PROVIDER_FAILURE"]
    },
    {
      "id": "project.service.task.restore",
      "purpose": "Preview and restore one recoverably deleted task from its deletion manifest",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "restore_preview",
        "exact_name_confirmation",
        "idempotent_write",
        "production_confirmation",
        "post_write_readback",
        "structured_json"
      ],
      "input_fields": [
        "profile",
        "deletion_id",
        "confirm_task",
        "idempotency_key"
      ],
      "output_fields": [
        "target",
        "deletion_id",
        "project",
        "task",
        "warnings",
        "verification"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "The user must review the restore preview and explicitly confirm the exact task name; production additionally requires CLI confirmation."
      },
      "errors": [
        "AUTH_REQUIRED",
        "RESTORE_CONFIRMATION_MISMATCH",
        "RESTORE_CONFLICT",
        "INVALID_RESTORE_STATE",
        "FILE_INTEGRITY",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "project.service.project.create",
      "purpose": "Create one project in the selected project-management service and verify its generated structure",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "dry_run",
        "production_confirmation",
        "idempotent_write",
        "post_write_readback",
        "structured_json"
      ],
      "input_fields": [
        "profile",
        "name",
        "goal",
        "type",
        "template",
        "sop_file",
        "mode",
        "idempotency_key"
      ],
      "output_fields": [
        "target",
        "project",
        "tasks",
        "wiki",
        "idempotency_key"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "The user must explicitly intend to create the project; production additionally requires CLI confirmation."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "PERMISSION_REQUIRED",
        "PROVIDER_FAILURE",
        "OUTPUT_CONTRACT_FAILED",
        "PROJECT_NAME_CONFLICT",
        "SOP_NODE_INCOMPLETE",
        "FEATURE_UNSUPPORTED"
      ]
    },
    {
      "id": "project.service.project.delete",
      "purpose": "Soft-delete one exactly named project as a system administrator and verify the deletion",
      "required": true,
      "required_features": [
        "profile_selection",
        "target_identity_verification",
        "dry_run",
        "admin_authorization",
        "exact_name_confirmation",
        "idempotent_write",
        "post_write_readback",
        "structured_json"
      ],
      "input_fields": ["profile", "name", "confirm_name", "idempotency_key"],
      "output_fields": [
        "target",
        "project_id",
        "project_name",
        "deleted_at",
        "deleted_by",
        "recoverable",
        "idempotency_key"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "The user must explicitly intend to delete the project and the authenticated identity must have the system admin role."
      },
      "errors": [
        "AUTH_REQUIRED",
        "ADMIN_REQUIRED",
        "DELETE_CONFIRMATION_MISMATCH",
        "NOT_FOUND",
        "OUTPUT_CONTRACT_FAILED"
      ]
    }
  ]
}
