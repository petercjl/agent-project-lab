{
  "schemaVersion": "1",
  "name": "procli",
  "version": "0.2.0",
  "defaultProfile": "nas",
  "capabilities": [
    {
      "id": "project.create",
      "command": "procli project create",
      "effect": "write",
      "risk": "medium",
      "requiredInputs": ["name"],
      "optionalInputs": [
        "goal",
        "type",
        "template",
        "sopFile",
        "mode",
        "profile",
        "idempotencyKey"
      ],
      "supports": [
        "dryRun",
        "idempotency",
        "targetVerification",
        "postWriteReadback"
      ],
      "productionConfirmation": true
    },
    {
      "id": "project.delete",
      "command": "procli project delete",
      "effect": "soft-delete",
      "risk": "high",
      "requiredInputs": ["name", "confirmName", "yes"],
      "optionalInputs": ["profile", "idempotencyKey"],
      "supports": [
        "dryRun",
        "idempotency",
        "targetVerification",
        "postWriteReadback",
        "recoverableDeletion"
      ],
      "requiredSystemRole": "admin",
      "confirmationRequired": true
    }
  ]
}
