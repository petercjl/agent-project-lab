{
  "schemaVersion": "1",
  "name": "procli",
  "version": "0.3.0",
  "defaultProfile": "nas",
  "capabilities": [
    {
      "id": "directory.list",
      "command": "procli directory list",
      "effect": "read",
      "risk": "low",
      "requiredInputs": [],
      "optionalInputs": ["profile"],
      "supports": ["targetVerification", "structuredJson"]
    },
    {
      "id": "task.list",
      "command": "procli task list",
      "effect": "read",
      "risk": "low",
      "requiredInputs": ["project"],
      "optionalInputs": ["profile"],
      "supports": [
        "projectNameResolution",
        "targetVerification",
        "structuredJson"
      ]
    },
    {
      "id": "task.get",
      "command": "procli task get",
      "effect": "read",
      "risk": "low",
      "requiredInputs": ["project", "task"],
      "optionalInputs": ["profile"],
      "supports": [
        "projectNameResolution",
        "taskNameResolution",
        "statusHistory",
        "relatedRecords",
        "targetVerification",
        "structuredJson"
      ]
    },
    {
      "id": "project.create",
      "command": "procli project create",
      "effect": "write",
      "risk": "medium",
      "requiredInputs": ["name"],
      "optionalInputs": [
        "goal",
        "type",
        "template",
        "sopFile",
        "mode",
        "profile",
        "idempotencyKey"
      ],
      "supports": [
        "dryRun",
        "idempotency",
        "targetVerification",
        "postWriteReadback"
      ],
      "productionConfirmation": true
    },
    {
      "id": "project.delete",
      "command": "procli project delete",
      "effect": "soft-delete",
      "risk": "high",
      "requiredInputs": ["name", "confirmName", "yes"],
      "optionalInputs": ["profile", "idempotencyKey"],
      "supports": [
        "dryRun",
        "idempotency",
        "targetVerification",
        "postWriteReadback",
        "recoverableDeletion"
      ],
      "requiredSystemRole": "admin",
      "confirmationRequired": true
    }
  ]
}
